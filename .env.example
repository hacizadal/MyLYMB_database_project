# Copy to .env (cp .env.example .env). .env is git-ignored. Every value is optional:
# the defaults below are used when .env is absent. Used by docker-compose.yml AND the Python scripts.
MARIADB_ROOT_PASSWORD=labpass
MARIADB_DATABASE=schemalab
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
# Affects ALTER durations: state it when comparing results. Lower it on machines with < 8 GB RAM.
INNODB_BUFFER_POOL_SIZE=1G
